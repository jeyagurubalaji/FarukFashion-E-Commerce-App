PORT=8080
NODE_ENV=development
FRONTEND_URL=https://my-frontend-url.vercel.app
MONGODB_URI=mongodb://localhost:27017/faruk_fashion

JWT_SECRET=my_jwt_secret_key_here
JWT_EXPIRES_IN=24h

GOOGLE_CLIENT_ID=my_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=my_google_client_secret

# Mail (Gmail app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=my_email@gmail.com
MAIL_PASS=my_email_app_password
MAIL_FROM=my_email@gmail.com

# Seller notifications
SELLER_PHONE=my_seller_phone_number
SELLER_EMAIL=my_seller_email@gmail.com
SUPPORT_PHONE=my_support_phone_number
SUPPORT_EMAIL=my_support_email@gmail.com
RESEND_API_KEY=my_resend_api_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_my_key_id
RAZORPAY_KEY_SECRET=my_razorpay_key_secret

# WhatsApp (Meta Cloud API or third-party)
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/MY_PHONE_ID/messages
WHATSAPP_API_TOKEN=my_whatsapp_temporary_or_permanent_token